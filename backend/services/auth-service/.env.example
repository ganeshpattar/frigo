PORT=4001
# Neon (production): postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Local: postgresql://postgres:root@127.0.0.1:5432/auth_service
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_ACCESS_SECRET=change_me_in_render
JWT_REFRESH_SECRET=change_me_in_render
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
RESET_CODE_TTL_MINUTES=15
USER_SERVICE_URL=http://localhost:4002
BCRYPT_ROUNDS=12
EXPOSE_DEMO_RESET_CODE=true
